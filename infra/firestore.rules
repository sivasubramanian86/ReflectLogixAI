rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 1: Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Hardened Helper Functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'kailasamsiva@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validation: UserProfile
    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.userId == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        data.role in ['user', 'admin'] &&
        data.preferredLanguage is string && data.preferredLanguage.size() <= 50;
    }

    // Entity Validation: JournalEntry
    function isValidJournalEntry(data, userId) {
      return data.userId == userId &&
        data.userId == request.auth.uid &&
        data.title is string && data.title.size() <= 200 &&
        data.content is string && data.content.size() <= 50000 &&
        data.createdAt is number &&
        data.updatedAt is number;
    }

    // ----------------------------------------------------
    // User Profiles Collection
    // ----------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        (incoming().role == 'user' || isAdmin());

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdTimestamp == existing().createdTimestamp &&
        (incoming().role == existing().role || isAdmin());

      allow delete: if isAdmin();

      // Subcollection: Tenant-Isolated Journals
      match /journals/{journalId} {
        allow get: if isOwner(userId) && isValidId(journalId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidId(journalId) &&
          isValidJournalEntry(incoming(), userId);

        allow update: if isOwner(userId) &&
          isValidId(journalId) &&
          isValidJournalEntry(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;

        allow delete: if isOwner(userId) && isValidId(journalId);
      }

      // Subcollection: Notification Preferences
      match /notifications/{configId} {
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(configId);
      }
    }

    // Admin Verification Registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Append-only Immutable Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if false;
    }
  }
}
